# --- envcheck Demo File ---

# 1. Valid variables
APP_NAME=MyAwesomeApp
PORT=3000

# 2. Warning: Duplicate Key
APP_NAME=AnotherName

# 3. Error: Invalid Format (no value, no equals)
INVALID_LINE_HERE

# 4. Warning: Empty Value
DATABASE_HOST=

# 5. Security: Potential Secret Detected (AWS Key pattern)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# 6. Security: Potential Private Key
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."

# 7. Formatting: Spacing issues (handled gracefully but good to test)
   BAD_SPACING = value
